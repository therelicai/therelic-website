---
import Layout from '../layouts/Layout.astro'

const PLANS = [
  {
    name: 'Free',
    price: '$0',
    period: '/mo',
    features: [
      { name: 'Retention', value: '7 days' },
      { name: 'Traces', value: '100/month' },
      { name: 'Agents', value: '3' },
      { name: 'Support', value: 'Community' },
    ],
    cta: 'Get started',
    ctaHref: 'https://app.therelic.dev',
    ctaSecondary: false,
  },
  {
    name: 'Team',
    price: '$50',
    period: '/mo',
    popular: true,
    features: [
      { name: 'Retention', value: '30 days' },
      { name: 'Traces', value: '10K/month' },
      { name: 'Agents', value: '25' },
      { name: 'Support', value: 'Priority' },
      { name: 'Team management', value: '✓' },
    ],
    cta: 'Upgrade to Team',
    ctaHref: 'https://app.therelic.dev',
    ctaSecondary: false,
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    period: '',
    features: [
      { name: 'Retention', value: '1 year' },
      { name: 'Traces', value: 'Unlimited' },
      { name: 'Agents', value: 'Unlimited' },
      { name: 'Support', value: 'Dedicated' },
      { name: 'SLA', value: '✓' },
      { name: 'SSO & SAML', value: '✓' },
    ],
    cta: 'Contact sales',
    ctaHref: 'mailto:sales@therelic.dev',
    ctaSecondary: true,
  },
]
---

<Layout title="Pricing — The Relic" description="Simple pricing for The Relic. Free, Team, and Enterprise plans. Start free and scale when you need to.">
  <div class="min-h-screen">
    <!-- Header -->
    <header class="border-b border-gray-800/50">
      <div class="mx-auto max-w-6xl px-6 py-6">
        <div class="flex items-center justify-between">
          <a href="/" class="text-xl font-bold text-white">The Relic</a>
          <nav class="flex items-center gap-6">
            <a href="/" class="text-sm font-medium text-gray-400 hover:text-white">Home</a>
            <a href="/pricing" class="text-sm font-medium text-relic-400">Pricing</a>
            <a href="https://app.therelic.dev" class="text-sm font-medium text-gray-400 hover:text-white">App</a>
            <a href="https://github.com/therelicai/relic" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-gray-400 hover:text-white">GitHub</a>
          </nav>
        </div>
      </div>
    </header>

    <!-- Hero -->
    <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mx-auto max-w-2xl text-center">
          <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">Pricing</h1>
          <p class="mt-4 text-lg text-gray-400">Simple plans. Start free. Scale when you need to.</p>
        </div>
      </div>
    </section>

    <!-- Plan cards -->
    <section class="pb-16">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid gap-8 sm:grid-cols-3">
          {PLANS.map((plan) => (
            <div
              class={plan.popular
                ? 'rounded-2xl border border-relic-500/50 bg-gray-950/80 p-8 ring-1 ring-relic-500/20'
                : 'rounded-2xl border border-gray-800 bg-gray-950/80 p-8'}
            >
              {plan.popular && (
                <span class="inline-block rounded-full bg-relic-500/20 px-3 py-1 text-xs font-medium text-relic-400">Popular</span>
              )}
              <h2 class="mt-4 text-lg font-semibold text-white">{plan.name}</h2>
              <p class="mt-2 text-3xl font-bold text-white">
                {plan.price}
                <span class="text-base font-normal text-gray-500">{plan.period}</span>
              </p>
              <ul class="mt-6 space-y-3 text-sm text-gray-400">
                {plan.features.map((f) => (
                  <li class="flex justify-between gap-4">
                    <span class="text-gray-500">{f.name}</span>
                    <span class="text-gray-300">{f.value}</span>
                  </li>
                ))}
              </ul>
              <a
                href={plan.ctaHref}
                class={plan.ctaSecondary
                  ? 'mt-8 block w-full rounded-lg border border-gray-700 bg-transparent py-3 text-center text-sm font-medium text-gray-300 transition hover:border-gray-600 hover:bg-gray-800/50'
                  : 'mt-8 block w-full rounded-lg bg-relic-500 py-3 text-center text-sm font-medium text-white transition hover:bg-relic-600'}
              >
                {plan.cta}
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Feature comparison table -->
    <section class="border-t border-gray-800/50 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="mb-8 text-2xl font-bold text-white">Feature comparison</h2>
        <div class="overflow-x-auto rounded-xl border border-gray-800">
          <table class="w-full min-w-[600px]">
            <thead>
              <tr class="border-b border-gray-800 bg-gray-900/50">
                <th class="px-6 py-4 text-left text-sm font-medium text-gray-400">Feature</th>
                <th class="px-6 py-4 text-center text-sm font-medium text-gray-400">Free</th>
                <th class="px-6 py-4 text-center text-sm font-medium text-relic-400">Team</th>
                <th class="px-6 py-4 text-center text-sm font-medium text-gray-400">Enterprise</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-800">
              <tr>
                <td class="px-6 py-4 text-sm text-gray-300">Retention</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">7 days</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">30 days</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">1 year</td>
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm text-gray-300">Traces/month</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">100</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">10K</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">Unlimited</td>
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm text-gray-300">Agents</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">3</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">25</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">Unlimited</td>
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm text-gray-300">Support</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">Community</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">Priority</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">Dedicated</td>
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm text-gray-300">Team management</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">—</td>
                <td class="px-6 py-4 text-center text-sm text-relic-400">✓</td>
                <td class="px-6 py-4 text-center text-sm text-relic-400">✓</td>
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm text-gray-300">SLA</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">—</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">—</td>
                <td class="px-6 py-4 text-center text-sm text-relic-400">✓</td>
              </tr>
              <tr>
                <td class="px-6 py-4 text-sm text-gray-300">SSO & SAML</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">—</td>
                <td class="px-6 py-4 text-center text-sm text-gray-400">—</td>
                <td class="px-6 py-4 text-center text-sm text-relic-400">✓</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-gray-800/50 py-12">
      <div class="mx-auto max-w-6xl px-6">
        <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
          <div class="flex items-center gap-6">
            <a href="/" class="text-sm font-medium text-gray-400 hover:text-white">Home</a>
            <a href="/pricing" class="text-sm font-medium text-gray-400 hover:text-white">Pricing</a>
            <a href="https://app.therelic.dev" class="text-sm font-medium text-gray-400 hover:text-white">App</a>
            <a href="https://github.com/therelicai/relic" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-gray-400 hover:text-white">GitHub</a>
          </div>
          <p class="text-sm text-gray-500">© {new Date().getFullYear()} The Relic. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </div>
</Layout>
