---
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <!-- Navigation -->
  <nav class="fixed top-0 z-50 w-full border-b border-white/[0.06] bg-black/70 backdrop-blur-2xl">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-8">
      <a href="/" id="brandHome" class="flex items-center gap-3 text-[17px] font-semibold tracking-tight">
        <svg width="30" height="30" viewBox="0 0 80 80" fill="none" aria-hidden="true">
          <path d="M 4 4 L 58 4 L 76 22 L 76 76 L 22 76 L 4 58 Z" stroke="currentColor" stroke-width="6" stroke-linejoin="miter"/>
          <ellipse cx="40" cy="40" rx="22" ry="9" stroke="currentColor" stroke-width="4"/>
        </svg>
        The Relic
      </a>
      <div class="hidden items-center gap-9 md:flex">
        <a href="#see-dashboard" class="text-[14px] text-neutral-400 transition hover:text-white">See it</a>
        <a href="#story" class="text-[14px] text-neutral-400 transition hover:text-white">Story</a>
        <a href="#pillars" class="text-[14px] text-neutral-400 transition hover:text-white">Pillars</a>
        <a href="#integrations" class="text-[14px] text-neutral-400 transition hover:text-white">Integrations</a>
        <a href="#stack" class="text-[14px] text-neutral-400 transition hover:text-white">Platform</a>
        <a href="https://github.com/therelicai/therelic" target="_blank" rel="noopener noreferrer" class="text-[14px] text-neutral-400 transition hover:text-white">GitHub</a>
      </div>
    </div>
  </nav>

  <!-- ════════════════════════════════════════════════════════
       HERO: Centered, symmetrical, infographic.
       ════════════════════════════════════════════════════════ -->
  <section class="relative flex min-h-[92vh] items-center overflow-hidden pt-20">
    <div class="absolute inset-0">
      <!-- soft blue veil at top + neutral wash at bottom -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_45%_at_50%_-5%,rgba(12,147,232,0.16),transparent_65%)]" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_120%,rgba(255,255,255,0.04),transparent_70%)]" />
      <div class="absolute bottom-0 h-px w-full bg-gradient-to-r from-transparent via-white/10 to-transparent" />
    </div>
    <div class="relative mx-auto w-full max-w-7xl px-6 py-20 lg:px-8 lg:py-24">
      <div class="grid items-center gap-16 lg:grid-cols-12 lg:gap-10">
        <div class="text-center lg:col-span-7 lg:text-left">
          <h1 class="reveal text-hero gradient-muted">
            See every agent.<br />
            <span class="text-white">Govern every decision.</span>
          </h1>
          <p class="reveal reveal-delay-1 mx-auto mt-7 max-w-xl text-lead text-neutral-300 lg:mx-0">
            The Relic is the authorization layer for the agent era.
          </p>
          <div class="reveal reveal-delay-2 mt-10 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
            <a href="https://github.com/therelicai/therelic#quickstart" class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-[14px] font-medium text-black transition hover:bg-neutral-200">
              Quickstart
              <svg class="ml-1.5 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
            <a href="#see-dashboard" class="inline-flex items-center justify-center rounded-full border border-white/15 px-6 py-3 text-[14px] font-medium text-white transition hover:border-white/30 hover:bg-white/5">
              See the platform
            </a>
          </div>
        </div>

      <!-- ───── HERO INFOGRAPHIC: Vertical 3-layer cosmogram ─────
           Top: rotating ring of agent dots (OBSERVE: the fleet).
           Middle: spacetime well / black hole (GOVERN: the policy engine).
           Bottom: rotating ring of action cubes (AUDIT: the signed record).
           A pulse falls from the top ring through the well and emerges below.
      -->
        <div class="reveal reveal-delay-3 lg:col-span-5">
          <div class="hero-infographic mx-auto w-full max-w-md lg:ml-auto lg:mr-0" role="img" aria-label="Three-layer diagram: a rotating ring of agent dots above representing the fleet (Observe); a wireframe spacetime well in the middle representing policy gravity (Govern); a rotating ring of action cubes below representing the signed record (Audit). A pulse travels through all three layers.">
            <svg viewBox="-220 -290 440 620" class="mx-auto block h-auto w-full" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <radialGradient id="singularityGlow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="rgba(54,173,247,1)" />
                  <stop offset="40%" stop-color="rgba(12,147,232,0.6)" />
                  <stop offset="100%" stop-color="rgba(12,147,232,0)" />
                </radialGradient>
                <radialGradient id="ringHalo" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="rgba(12,147,232,0.18)" />
                  <stop offset="100%" stop-color="rgba(12,147,232,0)" />
                </radialGradient>
                <linearGradient id="actionCube" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="rgba(54,173,247,1)" />
                  <stop offset="100%" stop-color="rgba(12,147,232,1)" />
                </linearGradient>
                <!-- Animation paths -->
                <path id="topRingPath" d="M 130 -210 a 130 32 0 1 1 -260 0 a 130 32 0 1 1 260 0" />
                <path id="bottomRingPath" d="M 130 210 a 130 32 0 1 1 -260 0 a 130 32 0 1 1 260 0" />
                <path id="pulseFallPath" d="M 0 -210 L 0 -100 L 0 80" />
                <path id="pulseEmergePath" d="M 0 80 L 0 100 L 0 210" />
              </defs>

              <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                   1. AXIS LINE (subtle, behind everything)
                   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
              <line x1="0" y1="-210" x2="0" y2="210"
                    stroke="rgba(255,255,255,0.1)" stroke-width="0.6"
                    stroke-dasharray="2 4" />

              <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                   2. TOP: Observe (rotating ring of agents)
                   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
              <!-- soft halo behind ring -->
              <ellipse cx="0" cy="-210" rx="160" ry="42" fill="url(#ringHalo)" />
              <!-- ring path -->
              <ellipse cx="0" cy="-210" rx="130" ry="32" fill="none"
                       stroke="rgba(255,255,255,0.35)" stroke-width="1"
                       stroke-dasharray="2 3" class="ring-flow" />
              <!-- 6 agent dots orbiting around the ring -->
              <g class="agent-dots">
                <circle r="2.5" fill="rgba(255,255,255,0.55)">
                  <animateMotion dur="22s" repeatCount="indefinite" begin="0s">
                    <mpath href="#topRingPath" />
                  </animateMotion>
                </circle>
                <circle r="3.5" fill="rgba(54,173,247,1)" class="active-agent">
                  <animateMotion dur="22s" repeatCount="indefinite" begin="-3.66s">
                    <mpath href="#topRingPath" />
                  </animateMotion>
                </circle>
                <circle r="2.5" fill="rgba(255,255,255,0.55)">
                  <animateMotion dur="22s" repeatCount="indefinite" begin="-7.33s">
                    <mpath href="#topRingPath" />
                  </animateMotion>
                </circle>
                <circle r="2.5" fill="rgba(255,255,255,0.55)">
                  <animateMotion dur="22s" repeatCount="indefinite" begin="-11s">
                    <mpath href="#topRingPath" />
                  </animateMotion>
                </circle>
                <circle r="3.5" fill="rgba(54,173,247,1)" class="active-agent">
                  <animateMotion dur="22s" repeatCount="indefinite" begin="-14.66s">
                    <mpath href="#topRingPath" />
                  </animateMotion>
                </circle>
                <circle r="2.5" fill="rgba(255,255,255,0.55)">
                  <animateMotion dur="22s" repeatCount="indefinite" begin="-18.33s">
                    <mpath href="#topRingPath" />
                  </animateMotion>
                </circle>
              </g>

              <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                   3. MIDDLE: Govern (spacetime well)
                   Concentric ellipses warped downward into a singularity.
                   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
              <g class="govern-well">
                <!-- Outer rim of well (top opening) -->
                <ellipse cx="0" cy="-110" rx="135" ry="22" fill="none"
                         stroke="rgba(255,255,255,0.32)" stroke-width="1" />
                <!-- Descending contour rings (concentric, getting smaller and lower) -->
                <ellipse cx="0" cy="-72" rx="110" ry="18" fill="none"
                         stroke="rgba(255,255,255,0.30)" stroke-width="0.9" />
                <ellipse cx="0" cy="-36" rx="85" ry="14" fill="none"
                         stroke="rgba(255,255,255,0.32)" stroke-width="0.85" />
                <ellipse cx="0" cy="-4" rx="62" ry="11" fill="none"
                         stroke="rgba(255,255,255,0.36)" stroke-width="0.85" />
                <ellipse cx="0" cy="26" rx="42" ry="8" fill="none"
                         stroke="rgba(54,173,247,0.5)" stroke-width="0.9" />
                <ellipse cx="0" cy="52" rx="25" ry="5" fill="none"
                         stroke="rgba(54,173,247,0.7)" stroke-width="0.9" />
                <ellipse cx="0" cy="72" rx="12" ry="3" fill="none"
                         stroke="rgba(54,173,247,0.95)" stroke-width="1" />

                <!-- Funnel side walls: bezier curves showing the warp -->
                <!-- right side -->
                <path d="M 135 -110 Q 105 -55 65 -5 Q 35 35 18 60 L 6 78"
                      fill="none" stroke="rgba(255,255,255,0.22)" stroke-width="0.8" />
                <!-- left side -->
                <path d="M -135 -110 Q -105 -55 -65 -5 Q -35 35 -18 60 L -6 78"
                      fill="none" stroke="rgba(255,255,255,0.22)" stroke-width="0.8" />
                <!-- subtle front warp lines -->
                <path d="M -68 -88 Q -40 -20 -10 50 L -3 75"
                      fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="0.6" />
                <path d="M 68 -88 Q 40 -20 10 50 L 3 75"
                      fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="0.6" />

                <!-- Singularity at the bottom: the event horizon -->
                <circle cx="0" cy="80" r="28" fill="url(#singularityGlow)" class="singularity-glow" />
                <circle cx="0" cy="80" r="6" fill="rgba(54,173,247,1)" class="singularity-core" />
              </g>

              <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                   4. BOTTOM: Audit (rotating ring of action cubes)
                   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
              <!-- soft halo -->
              <ellipse cx="0" cy="210" rx="160" ry="42" fill="url(#ringHalo)" />
              <!-- ring path -->
              <ellipse cx="0" cy="210" rx="130" ry="32" fill="none"
                       stroke="rgba(255,255,255,0.35)" stroke-width="1"
                       stroke-dasharray="2 3" class="ring-flow" />
              <!-- 6 action cubes orbiting -->
              <g class="action-cubes">
                <rect x="-3" y="-3" width="6" height="6" rx="1.5" fill="url(#actionCube)" stroke="rgba(255,255,255,0.5)" stroke-width="0.5">
                  <animateMotion dur="22s" repeatCount="indefinite" begin="0s">
                    <mpath href="#bottomRingPath" />
                  </animateMotion>
                </rect>
                <rect x="-3" y="-3" width="6" height="6" rx="1.5" fill="url(#actionCube)" stroke="rgba(255,255,255,0.5)" stroke-width="0.5">
                  <animateMotion dur="22s" repeatCount="indefinite" begin="-3.66s">
                    <mpath href="#bottomRingPath" />
                  </animateMotion>
                </rect>
                <rect x="-3" y="-3" width="6" height="6" rx="1.5" fill="url(#actionCube)" stroke="rgba(255,255,255,0.5)" stroke-width="0.5">
                  <animateMotion dur="22s" repeatCount="indefinite" begin="-7.33s">
                    <mpath href="#bottomRingPath" />
                  </animateMotion>
                </rect>
                <rect x="-3" y="-3" width="6" height="6" rx="1.5" fill="url(#actionCube)" stroke="rgba(255,255,255,0.5)" stroke-width="0.5">
                  <animateMotion dur="22s" repeatCount="indefinite" begin="-11s">
                    <mpath href="#bottomRingPath" />
                  </animateMotion>
                </rect>
                <rect x="-3" y="-3" width="6" height="6" rx="1.5" fill="url(#actionCube)" stroke="rgba(255,255,255,0.5)" stroke-width="0.5">
                  <animateMotion dur="22s" repeatCount="indefinite" begin="-14.66s">
                    <mpath href="#bottomRingPath" />
                  </animateMotion>
                </rect>
                <rect x="-3" y="-3" width="6" height="6" rx="1.5" fill="url(#actionCube)" stroke="rgba(255,255,255,0.5)" stroke-width="0.5">
                  <animateMotion dur="22s" repeatCount="indefinite" begin="-18.33s">
                    <mpath href="#bottomRingPath" />
                  </animateMotion>
                </rect>
              </g>

              <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                   5. PULSE: Intent falls through the well,
                      emerges as an audited action on the other side.
                   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
              <!-- Intent falling into the well -->
              <circle r="3" fill="rgba(255,255,255,0.95)" class="pulse-fall">
                <animateMotion dur="5s" repeatCount="indefinite" begin="0s">
                  <mpath href="#pulseFallPath" />
                </animateMotion>
                <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.32;0.42" dur="5s" repeatCount="indefinite" />
              </circle>
              <!-- Audited action emerging -->
              <circle r="3" fill="rgba(54,173,247,1)" class="pulse-emerge">
                <animateMotion dur="5s" repeatCount="indefinite" begin="0s">
                  <mpath href="#pulseEmergePath" />
                </animateMotion>
                <animate attributeName="opacity" values="0;0;1;1;0" keyTimes="0;0.5;0.55;0.85;0.95" dur="5s" repeatCount="indefinite" />
              </circle>

              <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                   6. LABEL PILLS: rounded, brand-aligned
                   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
              <g class="layer-labels">
                <!-- Left-side nouns (what the layer is) -->
                <text x="-145" y="-200" text-anchor="end"
                      fill="rgba(255,255,255,0.9)" font-size="11"
                      font-family="-apple-system, system-ui"
                      font-weight="500" letter-spacing="0.08em">AGENTS</text>
                <text x="-145" y="5" text-anchor="end"
                      fill="rgba(255,255,255,0.9)" font-size="11"
                      font-family="-apple-system, system-ui"
                      font-weight="500" letter-spacing="0.08em">GOVERN</text>
                <text x="-145" y="210" text-anchor="end"
                      fill="rgba(255,255,255,0.9)" font-size="11"
                      font-family="-apple-system, system-ui"
                      font-weight="500" letter-spacing="0.08em">ACTIONS</text>

                <!-- Right-side verbs (what The Relic does) -->
                <text x="145" y="-200"
                      fill="rgba(255,255,255,0.5)" font-size="10.5"
                      font-family="-apple-system, system-ui"
                      font-weight="500" letter-spacing="0.18em">OBSERVE</text>
                <text x="145" y="5"
                      fill="rgba(54,173,247,0.9)" font-size="10.5"
                      font-family="-apple-system, system-ui"
                      font-weight="500" letter-spacing="0.18em">POLICY</text>
                <text x="145" y="210"
                      fill="rgba(255,255,255,0.5)" font-size="10.5"
                      font-family="-apple-system, system-ui"
                      font-weight="500" letter-spacing="0.18em">AUDIT</text>
              </g>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════
       PRODUCT PREVIEWS: Tool-first: Dashboard, Live, Policy.
       Three browser-framed mockups right under the hero.
       ════════════════════════════════════════════════════════ -->

  <!-- ════════════════════════════════════════════════════════
       SCROLLYTELLING /01 · /02 · /03
       One pinned stage; the visual and the header swap as the
       reader scrolls. Outer section is tall (300vh-ish) so each
       step gets a full viewport-height of scroll. .scrolly-sticky
       pins to the top and crossfades between the three pairs.
       Mobile (under lg) falls back to vertical stacking — sticky
       scroll only works when the visual has room to live alone.
       ════════════════════════════════════════════════════════ -->
  <section id="see-previews" class="scrolly border-t border-white/[0.06]" data-steps="3">
    <div class="scrolly-sticky">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_45%_at_50%_0%,rgba(12,147,232,0.06),transparent_70%)]" />
      <div class="relative mx-auto flex h-full max-w-7xl flex-col px-6 py-16 lg:px-8 lg:py-20">

        <!-- ── Header stack ── -->
        <div class="scrolly-headers mx-auto w-full max-w-3xl text-center">
          <div class="scrolly-header" data-step="0" data-position="active">
            <p class="text-eyebrow uppercase tracking-[0.18em] text-relic-300">/01 · Dashboard</p>
            <h2 class="mt-5 text-section gradient-muted">Where your team<br />runs the fleet.</h2>
            <p class="mx-auto mt-7 max-w-xl text-lead text-neutral-400">
              Trends, denials, top offenders. One screen for the lead.
            </p>
          </div>
          <div class="scrolly-header" data-step="1" data-position="future">
            <p class="text-eyebrow uppercase tracking-[0.18em] text-relic-300">/02 · Live</p>
            <h2 class="mt-5 text-section gradient-muted">Watch your fleet,<br />live.</h2>
            <p class="mx-auto mt-7 max-w-xl text-lead text-neutral-400">
              Every intent surfaces before the verdict. Click any row to see the call, the parameters, and the rule that decided.
            </p>
          </div>
          <div class="scrolly-header" data-step="2" data-position="future">
            <p class="text-eyebrow uppercase tracking-[0.18em] text-relic-300">/03 · Policy</p>
            <h2 class="mt-5 text-section gradient-muted">Edit. Replay.<br />Save.</h2>
            <p class="mx-auto mt-7 max-w-xl text-lead text-neutral-400">
              Test every rule against your last 30 days of agent history. Then ship.
            </p>
          </div>
        </div>

        <!-- ── Mockup stack ── -->
        <div class="scrolly-mockups mx-auto mt-10 w-full max-w-6xl flex-1">
          <div class="scrolly-mockup" data-step="0" data-position="active">
          <div class="overflow-hidden rounded-2xl border border-white/10 bg-neutral-950 shadow-[0_50px_120px_-30px_rgba(12,147,232,0.25)]">
            <div class="flex items-center justify-between border-b border-white/5 bg-black/40 px-4 py-2.5">
              <div class="flex items-center gap-1.5">
                <div class="h-2.5 w-2.5 rounded-full bg-neutral-800"></div>
                <div class="h-2.5 w-2.5 rounded-full bg-neutral-800"></div>
                <div class="h-2.5 w-2.5 rounded-full bg-neutral-800"></div>
              </div>
              <div class="flex items-center gap-2 rounded-md bg-white/[0.04] px-3 py-1 text-[11px] text-neutral-500">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0-1.105.895-2 2-2s2 .895 2 2-.895 2-2 2-2-.895-2-2zM12 11V7m0 4v4" /></svg>
                app.therelic.dev
              </div>
              <div class="w-12"></div>
            </div>

            <div class="grid grid-cols-12 gap-0">
              <aside class="col-span-2 hidden border-r border-white/5 p-4 md:block">
                <svg width="22" height="22" viewBox="0 0 80 80" fill="none" class="mb-5">
                  <path d="M 4 4 L 58 4 L 76 22 L 76 76 L 22 76 L 4 58 Z" stroke="white" stroke-width="6" stroke-linejoin="miter"/>
                  <ellipse cx="40" cy="40" rx="22" ry="9" stroke="white" stroke-width="4"/>
                </svg>
                <p class="text-[10px] uppercase tracking-wider text-neutral-600">Workspace</p>
                <ul class="mt-3 space-y-1 text-[12px]">
                  <li class="rounded-md bg-white/5 px-2 py-1.5 text-white">Dashboard</li>
                  <li class="px-2 py-1.5 text-neutral-500">Live</li>
                  <li class="px-2 py-1.5 text-neutral-500">Traces</li>
                  <li class="px-2 py-1.5 text-neutral-500">Agents</li>
                  <li class="px-2 py-1.5 text-neutral-500">Policies</li>
                  <li class="px-2 py-1.5 text-neutral-500">Audit</li>
                </ul>
              </aside>

              <div class="col-span-12 p-6 md:col-span-10">
                <p class="text-[14px] font-semibold text-white">acme · prod overview</p>
                <p class="mt-0.5 text-[11px] text-neutral-500">30 day window</p>

                <div class="mt-5 grid grid-cols-4 gap-3">
                  <div class="rounded-lg border border-white/5 bg-white/[0.02] p-4">
                    <p class="text-[10px] uppercase tracking-wider text-neutral-600">Agents</p>
