<style>
  /* ── Scrollytelling product previews ────────
     Each .scrolly section is sized as N+1.5 viewport-heights tall so
     each step gets ~1.5 viewports of dwell time before the next one
     slides in. The inner .scrolly-sticky pins to the top for the
     duration of that scroll. Headers and mockups stack absolutely
     inside, and JS toggles data-position to drive a directional
     slide: future slides park off-right, past slides park off-left,
     active sits at center. Mobile (<lg) falls back to vertical
     stacking. */
  .scrolly {
    position: relative;
    /* 3 steps × 1.6 viewports/step = 4.8 viewports tall. Scrollable
       range is ~3.8 viewports, ~1.27 viewports of dwell per step. */
    height: calc(100vh * 4.8);
  }
  .scrolly-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .scrolly-headers,
  .scrolly-mockups {
    position: relative;
  }
  .scrolly-headers { min-height: 9.5rem; }
  .scrolly-header,
  .scrolly-mockup {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translate3d(140px, 0, 0);
    transition: opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    will-change: transform, opacity;
  }
  /* Active step: centered + visible. */
  .scrolly-header[data-position="active"],
  .scrolly-mockup[data-position="active"] {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    pointer-events: auto;
  }
  /* Past steps (idx < active): parked off-left. They exited that way
     as the active step replaced them. */
  .scrolly-header[data-position="past"],
  .scrolly-mockup[data-position="past"] {
    opacity: 0;
    transform: translate3d(-140px, 0, 0);
  }
  /* Future steps (idx > active): parked off-right, waiting. */
  .scrolly-header[data-position="future"],
  .scrolly-mockup[data-position="future"] {
    opacity: 0;
    transform: translate3d(140px, 0, 0);
  }
  .scrolly-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.18);
    transition: background 0.4s ease, transform 0.4s ease;
  }
  .scrolly-dot.is-active {
    background: rgb(124 200 251);
    transform: scale(1.5);
  }
  @media (max-width: 1023px) {
    .scrolly {
      height: auto;
    }
    .scrolly-sticky {
      position: static;
      height: auto;
      overflow: visible;
    }
    .scrolly-headers,
    .scrolly-mockups { min-height: 0; }
    .scrolly-header,
    .scrolly-mockup {
      position: static;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .scrolly-header + .scrolly-header,
    .scrolly-mockup + .scrolly-mockup {
      margin-top: 4rem;
    }
    .scrolly-progress { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scrolly-header,
    .scrolly-mockup {
      transition: opacity 0.3s linear;
      transform: none !important;
    }
    .scrolly-header[data-position="past"],
    .scrolly-mockup[data-position="past"],
    .scrolly-header[data-position="future"],
    .scrolly-mockup[data-position="future"] {
      opacity: 0;
    }
  }

  /* ── Pillar tabs ─────────────────────────── */
  .pillar-tab {
    color: rgb(163 163 163);
    transition: all 0.2s ease;
  }
  .pillar-tab:hover {
    color: white;
  }
  .pillar-tab.is-active {
    background: white;
    color: black;
  }
  /* Carousel: the four panels live side-by-side in a flex track.
     Clicking a tab translates the track horizontally to bring the
     selected panel into view. The wrapping container clips overflow
     so adjacent panels stay hidden until they slide in. */
  .pillar-track-wrap {
    overflow: hidden;
  }
  .pillar-track {
    display: flex;
    align-items: stretch;
    /* Slow + heavy ease so the slide reads as "transporting" rather
       than "snapping." The pillar carousel and the scrolly stage
       move at similar speeds so the page feels coherent. */
    transition: transform 1.6s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .pillar-panel {
    flex: 0 0 100%;
    min-width: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .pillar-track {
      transition: none;
    }
  }

  /* ── Hero cosmogram ──────────────────── */
  .ring-flow {
    animation: ringFlow 30s linear infinite;
  }
  @keyframes ringFlow {
    to { stroke-dashoffset: -100; }
  }
  .active-agent {
    animation: agentGlow 2.6s ease-in-out infinite;
    filter: drop-shadow(0 0 3px rgba(54, 173, 247, 0.6));
  }
  @keyframes agentGlow {
    0%, 100% { opacity: 0.65; }
    50% { opacity: 1; filter: drop-shadow(0 0 6px rgba(54, 173, 247, 0.9)); }
  }
  .singularity-glow {
    transform-origin: 0 80px;
    animation: singularityPulse 3.5s ease-in-out infinite;
  }
  @keyframes singularityPulse {
    0%, 100% { opacity: 0.7; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.15); }
  }
  .singularity-core {
    animation: coreFlicker 1.8s ease-in-out infinite;
  }
  @keyframes coreFlicker {
    0%, 100% { opacity: 0.85; }
    50% { opacity: 1; }
  }
</style>

<script>
  // Scrollytelling: pin the inner stage of each `.scrolly` section
  // while the reader scrolls. Each step gets a slot in [0..N-1].
  // We compute the active slot from scroll progress and tag every
  // header/mockup with data-position = "past" | "active" | "future".
  // CSS reads that attribute and slides each slide horizontally:
  // active sits centered, future parks off-right, past parks
  // off-left. The result is a directional carousel — new slides
  // enter from the right as the reader scrolls down.
  // Disabled below the lg breakpoint (1024px) — mobile gets vertical
  // stacking via CSS instead.
  const scrollySections = document.querySelectorAll<HTMLElement>('.scrolly');
  scrollySections.forEach((section) => {
    const headers = Array.from(section.querySelectorAll<HTMLElement>('.scrolly-header'));
    const mockups = Array.from(section.querySelectorAll<HTMLElement>('.scrolly-mockup'));
    const dots = Array.from(section.querySelectorAll<HTMLElement>('.scrolly-dot'));
    const total = headers.length;
    if (total === 0) return;
    let lastIdx = -1;

    const positionFor = (i: number, active: number): string => {
      if (i === active) return 'active';
      return i < active ? 'past' : 'future';
    };

    const applyIdx = (idx: number) => {
      if (idx === lastIdx) return;
      lastIdx = idx;
      headers.forEach((h, i) => h.dataset.position = positionFor(i, idx));
      mockups.forEach((m, i) => m.dataset.position = positionFor(i, idx));
      dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
    };

    const update = () => {
      // Mobile: CSS handles vertical stacking; force step 0 so all
      // the slides render in their default state.
      if (window.innerWidth < 1024) {
        applyIdx(0);
        return;
      }
      const rect = section.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      if (scrollable <= 0) return;
      const p = Math.max(0, Math.min(1, -rect.top / scrollable));
      const idx = Math.min(total - 1, Math.max(0, Math.floor(p * total)));
      applyIdx(idx);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { update(); ticking = false; });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  });

  // Pillar tab switcher: drive a horizontal carousel track. Each
  // tab maps to an index in PILLAR_ORDER; clicking sets the track's
  // transform so that panel scrolls into view. Order is the visual
  // left-to-right order in the markup; if the markup reorders, this
  // must reorder with it.
  const PILLAR_ORDER = ['policy', 'exfil', 'live', 'trace'] as const;
  const tabs = document.querySelectorAll<HTMLButtonElement>('.pillar-tab');
  const track = document.querySelector<HTMLDivElement>('.pillar-track');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.dataset.tab as (typeof PILLAR_ORDER)[number];
      const idx = PILLAR_ORDER.indexOf(id);
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      if (track && idx >= 0) {
        track.style.transform = `translate3d(-${idx * 100}%, 0, 0)`;
        track.dataset.active = id;
      }
    });
  });

  // Brew install copy-to-clipboard
  const brewBtn = document.getElementById('brewInstallBtn');
  const brewLabel = document.getElementById('brewInstallLabel');
  if (brewBtn && brewLabel) {
    brewBtn.addEventListener('click', async () => {
      const cmd = brewBtn.getAttribute('data-clipboard') ?? '';
      try {
        await navigator.clipboard.writeText(cmd);
        brewLabel.textContent = 'copied';
        setTimeout(() => { brewLabel.textContent = 'copy'; }, 1800);
      } catch {
        brewLabel.textContent = 'select & copy';
      }
    });
  }

  // Brand mark: smooth-scroll to top on the homepage; navigate to / from sub-pages.
  const brandHome = document.getElementById('brandHome');
  if (brandHome) {
    brandHome.addEventListener('click', (e) => {
      if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }

  // In-page anchor links: smooth-scroll to the target without writing the hash to the URL.
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      (target as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // If we arrived from a sub-page with /#section, let the browser scroll there,
  // then silently strip the hash from the URL.
  window.addEventListener('load', () => {
    if (window.location.hash) {
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }
  });
</script>
