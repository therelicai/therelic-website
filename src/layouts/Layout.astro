---
interface Props {
  title?: string
  description?: string
}

const {
  title = 'The Relic. See every agent. Govern every decision.',
  description = 'See every agent decision. Govern every action. The Relic is the observation and governance layer for autonomous AI agents. Open-source runtime, hosted control plane.',
} = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL('/og-image.png', Astro.site).toString()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Favicons. The ?v=4 query busts browser/CDN cache when the icon updates. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=4" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=4" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <!-- Open Graph (Slack, iMessage, LinkedIn, Discord, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="The Relic" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Relic. See every agent. Govern every decision." />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="The Relic. See every agent. Govern every decision." />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: dark;
      }

      html {
        scroll-behavior: smooth;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      /* Keep section headings clear of the fixed nav when scrolled-to. */
      :where(section[id], div[id]) {
        scroll-margin-top: 88px;
      }

      body {
        font-feature-settings: 'ss01', 'ss03', 'cv11';
      }

      /* Apple-style fluid headlines */
      .text-hero {
        font-size: clamp(2.75rem, 7vw, 6rem);
        line-height: 1.05;
        letter-spacing: -0.035em;
        font-weight: 600;
      }
      .text-section {
        font-size: clamp(2rem, 4.5vw, 3.75rem);
        line-height: 1.06;
        letter-spacing: -0.028em;
        font-weight: 600;
      }
      .text-eyebrow {
        font-size: 0.8125rem;
        line-height: 1.4;
        letter-spacing: 0.01em;
        font-weight: 500;
      }
      .text-lead {
        font-size: clamp(1.125rem, 1.6vw, 1.375rem);
        line-height: 1.45;
        letter-spacing: -0.012em;
        font-weight: 400;
      }

      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
                    transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }
      .reveal-delay-1 { transition-delay: 0.08s; }
      .reveal-delay-2 { transition-delay: 0.16s; }
      .reveal-delay-3 { transition-delay: 0.24s; }

      .gradient-text {
        background: linear-gradient(135deg, #ffffff 0%, #7cc8fb 55%, #0c93e8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .gradient-muted {
        background: linear-gradient(180deg, #ffffff 0%, #a3a3a3 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .code-glow {
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.06),
          0 40px 80px -20px rgba(12, 147, 232, 0.18),
          0 0 120px rgba(12, 147, 232, 0.08);
      }

      .glass {
        background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
      }

      .dot-flow {
        animation: dotPulse 2s ease-in-out infinite;
      }
      @keyframes dotPulse {
        0%, 100% { opacity: 0.3; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.4); }
      }

      .live-pulse {
        position: relative;
      }
      .live-pulse::before {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 9999px;
        background: currentColor;
        opacity: 0.4;
        animation: livePulse 2s ease-out infinite;
      }
      @keyframes livePulse {
        0% { transform: scale(0.8); opacity: 0.5; }
        100% { transform: scale(2.2); opacity: 0; }
      }
    </style>
  </head>
  <body class="min-h-screen bg-black font-sans text-white antialiased selection:bg-relic-500/30">
    <slot />
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -80px 0px' });

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
